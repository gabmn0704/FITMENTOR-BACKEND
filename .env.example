# Copy to .env (never commit .env). Variables are read by Spring from the environment.

# HTTP port
PORT=8080

# Profile: leave empty for local development (H2 in memory), "render" for Postgres.
SPRING_PROFILES_ACTIVE=

# Local development database (optional, defaults to in-memory H2 in PostgreSQL mode)
# DATABASE_URL=jdbc:h2:mem:fitmentor;MODE=PostgreSQL;DB_CLOSE_DELAY=-1

# PostgreSQL (render profile)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fitmentor
DATABASE_USER=fitmentor
DATABASE_PASSWORD=change-me

# JWT signing secret, at least 32 characters. Required in the prod and render profiles.
JWT_SECRET=replace-with-at-least-32-random-characters

# OAuth client id; Google ID tokens must be issued for this audience.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser origin allowed by CORS and WebSocket handshakes. "*" allows any origin.
FRONTEND_ORIGIN=http://localhost:5173

# FITMENTOR-IA service (pose analysis and coach). Local default: http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
